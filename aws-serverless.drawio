          </mxGeometry>
        </mxCell>
        <mxCell id="e2" value="② Lambda実行&lt;br&gt;(Invoke)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontFamily=Noto Sans JP;fontSize=11;fontColor=#232F3E;" edge="1" parent="1" source="apigw" target="lambda">
